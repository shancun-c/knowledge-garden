# Copy to ../private/knowledge-garden/runtime.env and load before starting.
# Keep real configuration and data outside this repository.
KNOWLEDGE_DATA_DIR=../private/knowledge-garden/data
KNOWLEDGE_ORIGIN=http://localhost:4187
KNOWLEDGE_PROXY_SECRET=replace-with-a-long-random-secret
# Optional: AI settings can also be configured per user in the website.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
